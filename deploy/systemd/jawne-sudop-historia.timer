[Unit]
Description=jawne — SUDOP historia, praca ciągła (jedno zapytanie w toku)

[Timer]
# Co godzine, ale przebieg trwa kilkanascie godzin (24 zapytania po ~52 min),
# a systemd POMIJA start jednostki, ktora juz dziala. Tyk co godzine jest wiec
# tylko wznowieniem po zakonczonym albo przerwanym przebiegu.
#
# ZMIERZONE 25.09.2026: pora nie ma znaczenia (udane pobrania o 15:31, 19:17,
# 22:51 i 23:42, nieudane o 01:36), a czas odpowiedzi nie zalezy od wielkosci
# zapytania — 3 730 wierszy wrocilo po 51 minutach, tyle samo co 216 wierszy.
# Dlatego okno godzinowe znika: ono nie chronilo urzedu, tylko nas spowalnialo.
OnCalendar=*-*-* *:07:00 Europe/Warsaw
Persistent=false

[Install]
WantedBy=timers.target
