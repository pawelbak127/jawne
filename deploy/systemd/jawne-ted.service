[Unit]
Description=jawne — zamowienia publiczne z TED (ogloszenia o udzieleniu)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jawne
Group=jawne
WorkingDirectory=/srv/jawne
EnvironmentFile=/etc/jawne/jawne.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/bash /srv/jawne/deploy/zadanie.sh ted
TimeoutStartSec=3h
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
