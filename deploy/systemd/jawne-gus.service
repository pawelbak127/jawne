[Unit]
Description=jawne — GUS BDL: ludność i budżety gmin
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jawne
Group=jawne
WorkingDirectory=/srv/jawne
EnvironmentFile=/etc/jawne/jawne.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/bash /srv/jawne/deploy/zadanie.sh gus
TimeoutStartSec=3h
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
