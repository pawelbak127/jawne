[Unit]
Description=jawne — SUDOP: wczoraj i dzień sprzed 14 dni (cały kraj, 1–2 zapytania)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jawne
Group=jawne
WorkingDirectory=/srv/jawne
EnvironmentFile=/etc/jawne/jawne.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/bash /srv/jawne/deploy/zadanie.sh sudop-dzien
TimeoutStartSec=6h
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
