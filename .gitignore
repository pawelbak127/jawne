# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Lokalna baza i wszystko, co pobrane.
# dane/ to nie tylko rozmiar: leza tam surowe odpowiedzi SUDOP, ktore
# ZAWIERAJA DANE OSOBOWE (nazwiska jednoosobowych firm, NIP-y). Nic z tego
# nie ma prawa trafic do repozytorium — ani publicznego, ani prywatnego.
dane/

# robocze
*.log
scratchpad/
.claude/
.idea/
.vscode/

# Materialy od urzedow: pisma, zalaczniki i instrukcje z przykladowymi
# kluczami (np. BIR1_Przyklady.docx od GUS). Zadne z nich nie jest potrzebne
# do zbudowania serwisu, a bywaja w nich poswiadczenia i dane osobowe.
# Trzymaj je w prywatne/ — ten katalog nie idzie do repozytorium.
prywatne/
*.eml
*.msg
*.docx
*.doc
*.xlsx
*.xls
*.pptx

# Zrodla danych, ktore trzymamy bajt w bajt, sa WYJATKIEM od reguly wyzej —
# dodaje sie je swiadomie: git add -f ingest/zrodla/<plik>
